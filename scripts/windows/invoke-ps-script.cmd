@echo off
setlocal EnableExtensions

if "%~1"=="" goto usage

set "SCRIPT=%~1"
shift
where pwsh.exe >nul 2>&1
if errorlevel 1 goto missing_pwsh

pwsh.exe -NoProfile -EncodedCommand  %*
exit /b %ERRORLEVEL%

:usage
echo Usage: %~nx0 script.ps1 [arguments...] 1>&2
exit /b 2

:missing_pwsh
echo PowerShell 7 (pwsh.exe) is required. 1>&2
exit /b 1
